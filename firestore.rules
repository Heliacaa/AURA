rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function publicProfileKeys() {
      return [
        'uid',
        'displayName',
        'email',
        'emailLowercase',
        'avatarUrl',
        'currentLevel',
        'currentClass',
        'xp',
        'streakDays',
        'updatedAt'
      ];
    }

    function friendshipKeys() {
      return [
        'friendName',
        'friendEmail',
        'status',
        'direction',
        'createdAt'
      ];
    }

    function validFriendshipShape() {
      return request.resource.data.keys().hasOnly(friendshipKeys())
        && request.resource.data.status in ['pending', 'accepted']
        && request.resource.data.direction in ['incoming', 'outgoing'];
    }

    function acceptsIncomingRequest(userId) {
      return owns(userId)
        && resource.data.status == 'pending'
        && resource.data.direction == 'incoming'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    function acceptsCounterpartOutgoing(friendId) {
      return signedIn()
        && request.auth.uid == friendId
        && resource.data.status == 'pending'
        && resource.data.direction == 'outgoing'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    match /users/{userId} {
      allow read, update: if owns(userId);
      allow create: if owns(userId);
      allow delete: if false;

      match /dailyLogs/{logId} {
        allow read, write: if owns(userId);
      }

      match /meals/{mealId} {
        allow read, write: if owns(userId);
      }

      match /chatHistory/{messageId} {
        allow read, write: if owns(userId);
      }

      match /achievements/{achievementId} {
        allow read: if owns(userId);
        allow create: if owns(userId);
        allow update, delete: if false;
      }

      match /friends/{friendId} {
        allow read: if owns(userId);
        allow create: if validFriendshipShape()
          && request.resource.data.status == 'pending'
          && (
            owns(userId)
            || (signedIn()
              && request.auth.uid == friendId
              && request.resource.data.direction == 'incoming')
          );
        allow update: if acceptsIncomingRequest(userId)
          || acceptsCounterpartOutgoing(friendId);
        allow delete: if owns(userId)
          || (signedIn() && request.auth.uid == friendId);
      }

      match /memories/{memoryId} {
        allow read, write: if owns(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(publicProfileKeys())
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /leaderboards/{weekKey}/entries/{entryId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == entryId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'currentLevel',
          'currentClass',
          'weeklyXp',
          'weekKey',
          'updatedAt'
        ])
        && request.resource.data.uid == entryId
        && request.resource.data.weekKey == weekKey;
      allow delete: if signedIn() && request.auth.uid == entryId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
