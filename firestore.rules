rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own private document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Daily logs subcollection
      match /dailyLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Meals subcollection
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat history subcollection
      match /chatHistory/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Achievements subcollection
      match /achievements/{achievementId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Memories subcollection (RAG)
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public profile projection. No private body fields live here.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'avatarUrl',
          'currentLevel',
          'currentClass',
          'xp',
          'streakDays',
          'weeklyXp',
          'weeklyXpWeek',
          'updatedAt'
        ])
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Directed friendships are created and changed by callable functions.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

    // Public weekly leaderboard projection. Entries contain only public stats.
    match /leaderboards/{weekKey}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == entryId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'currentLevel',
          'currentClass',
          'weeklyXp',
          'weekKey',
          'updatedAt'
        ])
        && request.resource.data.uid == entryId
        && request.resource.data.weekKey == weekKey;
      allow delete: if request.auth != null && request.auth.uid == entryId;
    }

    // Social Collections
    match /social_challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /social_activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
