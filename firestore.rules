rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own private document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Daily logs subcollection
      match /dailyLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Meals subcollection
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat history subcollection
      match /chatHistory/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Achievements subcollection
      match /achievements/{achievementId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Memories subcollection (RAG)
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public profile projection. No private body fields live here.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'emailLower',
          'avatarUrl',
          'currentLevel',
          'currentClass',
          'xp',
          'streakDays',
          'weeklyXp',
          'weeklyXpWeek',
          'updatedAt'
        ])
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Friend-visible profile details. Height and weight are intentionally absent.
    match /friendProfiles/{userId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + userId))
            && get(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + userId)).data.status == 'accepted'
          || exists(/databases/$(database)/documents/friendships/$(userId + "_" + request.auth.uid))
            && get(/databases/$(database)/documents/friendships/$(userId + "_" + request.auth.uid)).data.status == 'accepted'
        );
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'age',
          'dailyGoals',
          'socialEnergyLevel',
          'updatedAt'
        ])
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Exact-email lookup projection. Clients use get(), not list().
    match /userSearch/{emailKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower == emailKey
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'emailLower',
          'avatarUrl',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Directed friendships can be managed by authenticated participants.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'participantUids',
          'requesterUid',
          'recipientUid',
          'status',
          'createdAt',
          'updatedAt',
          'requester',
          'recipient'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.requesterUid != request.resource.data.recipientUid
        && request.resource.data.status == 'pending'
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.requesterUid in request.resource.data.participantUids
        && request.resource.data.recipientUid in request.resource.data.participantUids;
      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.recipientUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'updatedAt',
              'acceptedAt'
            ])
          || request.auth.uid == resource.data.requesterUid
            && resource.data.status == 'pending'
            && request.resource.data.keys().hasOnly([
              'participantUids',
              'requesterUid',
              'recipientUid',
              'status',
              'createdAt',
              'updatedAt',
              'requester',
              'recipient'
            ])
            && request.resource.data.requesterUid == resource.data.requesterUid
            && request.resource.data.recipientUid == resource.data.recipientUid
            && request.resource.data.status == 'pending'
            && request.resource.data.participantUids is list
            && request.resource.data.participantUids.size() == 2
            && request.resource.data.requesterUid in request.resource.data.participantUids
            && request.resource.data.recipientUid in request.resource.data.participantUids
        );
      allow delete: if request.auth != null
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids;
    }

    // Public weekly leaderboard projection. Entries contain only public stats.
    match /leaderboards/{weekKey}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == entryId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'currentLevel',
          'currentClass',
          'weeklyXp',
          'weekKey',
          'updatedAt'
        ])
        && request.resource.data.uid == entryId
        && request.resource.data.weekKey == weekKey;
      allow delete: if request.auth != null && request.auth.uid == entryId;
    }

    // Social Collections
    match /social_challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /social_activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
